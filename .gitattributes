# 统一换行符：仓库内 LF，检出时按平台处理
* text=auto

# Windows 脚本必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件固定 LF
package-lock.json text eol=lf

# 二进制文件不做任何转换
*.exe   binary
*.dll   binary
*.node  binary
*.db    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.woff  binary
*.woff2 binary